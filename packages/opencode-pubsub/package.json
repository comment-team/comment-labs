{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@comment-labs/opencode-pubsub",
  "version": "0.1.0-beta.1",
  "description": "Cross-session pub/sub plugin for opencode: subscribe a session to a channel and published messages wake it as tasks",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.14.19"
  },
  "devDependencies": {
    "@comment-labs/oxlint-config": "workspace:*",
    "@comment-labs/tsconfig": "workspace:*",
    "@opencode-ai/sdk": "1.18.29",
    "@types/node": "catalog:types",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "tsdown": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vitest": "catalog:test"
  },
  "publishConfig": {
    "access": "public"
  }
}
