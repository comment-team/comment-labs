{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@comment-labs/i18next-validator",
  "version": "0.1.0-beta.8",
  "description": "Configless CLI for finding unused i18next translation keys",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "bin": {
    "i18next-validator": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@bomb.sh/args": "^0.3.1",
    "@bomb.sh/tab": "^0.0.22",
    "@clack/prompts": "^1.7.0",
    "nostics": "^1.2.0",
    "oxc-parser": "^0.146.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@comment-labs/oxlint-config": "workspace:*",
    "@comment-labs/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "tsdown": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vitest": "catalog:test"
  },
  "publishConfig": {
    "access": "public"
  }
}
