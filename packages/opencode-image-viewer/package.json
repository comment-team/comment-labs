{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@comment-labs/opencode-image-viewer",
  "version": "0.1.1",
  "description": "opencode plugin: viewimage tool that outsources image viewing to a vision subagent (config agent \"image-viewer\") for models that cannot see images.",
  "license": "Apache-2.0",
  "author": "CommEnt Team",
  "type": "module",
  "main": "./dist/index.mjs",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.16"
  },
  "devDependencies": {
    "@comment-labs/oxlint-config": "workspace:*",
    "@comment-labs/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "tsdown": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vitest": "catalog:test"
  },
  "publishConfig": {
    "access": "public"
  }
}
