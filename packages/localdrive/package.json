{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@comment-labs/localdrive",
  "version": "0.1.0-beta.9",
  "description": "Local PostgreSQL Hyperdrive emulation for Vitest",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.mts",
      "import": "./dist/vitest.mjs"
    },
    "./query": {
      "types": "./dist/query-client.d.mts",
      "import": "./dist/query-client.mjs"
    },
    "./cloudflare-test": {
      "types": "./dist/cloudflare-test-client.d.mts",
      "import": "./dist/cloudflare-test-client.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "import": "./dist/playwright.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:test",
    "@cloudflare/workers-types": "catalog:types",
    "@comment-labs/oxlint-config": "workspace:*",
    "@comment-labs/tsconfig": "workspace:*",
    "@playwright/test": "catalog:test",
    "@types/node": "catalog:types",
    "@vitest/coverage-v8": "catalog:test",
    "@vitest/runner": "catalog:test",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "tsdown": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vitest": "catalog:test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@electric-sql/pglite-socket": "0.2.8",
    "postgres": "3.4.9",
    "tinyglobby": "0.2.17"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
