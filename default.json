{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "commitMessagePrefix": ":paperclip:",
  "configMigration": true,
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":automergeDigest",
    ":automergeMinor",
    ":automergeRequireAllStatusChecks",
    "npm:unpublishSafe",
    "workarounds:nodeDockerVersioning",
    "workarounds:typesNodeVersioning"
  ],
  "npmrcMerge": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "matchDepTypes": [ "dependencies" ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "dependencies{{#if (equals parentDir '')}}{{else}}-{{parentDir}}{{/if}}",
      "commitMessageSuffix": "({{#if (equals parentDir '')}}root{{else}}{{parentDir}}{{/if}})"
    },
    {
      "matchDepTypes": [ "devDependencies" ],
      "matchUpdateTypes": [
          "minor",
          "patch"
      ],
      "rangeStrategy": "pin",
      "groupName": "devDependencies"
    },
    {
      "matchDepTypes": [ "pnpm.overrides" ],
      "enabled": false
    },
    {
      "matchCurrentVersion": "/^(0.)|.*-/",
      "groupName": "{{{depNameSanitized}}}"
    },
    {
      "matchDepNames": [ "zod" ],
      "groupName": "zod"
    },
    {
      "matchDepNames": [ "prisma", "@prisma/client" ],
      "groupName": "prisma"
    },
    {
      "matchDepNames": [ "playwright", "@playwright/test" ],
      "groupName": "playwright"
    },
    {
      "matchDepNames": [ "drizzle-orm", "drizzle-kit", "drizzle-zod" ],
      "groupName": "drizzle"
    },
    {
      "matchDepNames": [
        "@lexical/*",
        "lexical",
        "lexical-vue"
      ],
      "groupName": "lexical"
    },
    {
      "matchDepNames": [
        "lucide-vue-next",
        "lucide-react",
        "lucide-react-native"
      ],
      "groupName": "lucide"
    },
    {
      "matchDepNames": [
        "@hcengineering/*"
      ],
      "groupName": "{{parentDir}}-huly",
      "prPriority": -1
    },
    {
      "matchPackageNames": [
        "wrangler",
        "@cloudflare/vite-plugin",
        "@cloudflare/workers-types",
        "@cloudflare/vitest-plugin",
        "@cloudflare/vitest-pool-workers"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "prPriority": 5,
      "groupName": "cloudflare"
    },
    {
      "matchPackageNames": [
        "@cloudflare/workers-types"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "cloudflare",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": [
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt",
        "@comment-labs/oxlint-config"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "groupName": "oxc",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": [
        "better-auth",
        "better-call",
        "auth",
        "@better-auth/*"
      ],
      "groupName": "better-auth",
      "prPriority": -1,
      "automerge": false
    },
    {
      "matchPackageNames": [ "eslint", "bundled-eslint-config" ],
      "groupName": "eslint"
    },
    {
      "matchPackageNames": [ "astro", "@astrojs/*" ],
      "groupName": "astro"
    },
    {
      "matchPackageNames": [
        "@electric-sql/*"
      ],
      "groupName": "electric-sql"
    },
    {
      "matchFileNames": ["pnpm-workspace.yaml"],
      "groupName": "pnpm-workspace",
      "prPriority": -10
    }
  ],
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "schedule": [
    "* 1-8 * * *"
  ],
  "timezone": "CET",
  "updateNotScheduled": true
}
